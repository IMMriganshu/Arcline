---
---

<section id="hero" class="relative pt-28 md:pt-36 pb-16 md:pb-24 overflow-hidden">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <!-- Huge Oversized Typography with Architectural Image Mask (Matching Recording 00:00-00:10) -->
    <div class="text-center mb-6 md:mb-10 overflow-hidden">
      <h1
        id="hero-title"
        class="hero-masked-text font-urbanist uppercase tracking-tight transform-gpu transition-transform duration-700 hover:scale-[1.01]"
        aria-label="Arcline"
      >
        Arcline
      </h1>
    </div>

    <!-- Large Rounded Architectural Hero Image (Matching Recording 00:00-00:10) -->
    <div class="relative w-full overflow-hidden rounded-2xl md:rounded-3xl shadow-xl border border-black/5 group">
      <div class="aspect-[16/9] md:aspect-[21/10] w-full overflow-hidden bg-neutral-200">
        <img
          id="hero-img"
          src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2100&q=85"
          alt="Modern architectural interior with sculptural wooden staircase and floor-to-ceiling glass"
          class="w-full h-full object-cover object-center transform transition-transform duration-1000 ease-out group-hover:scale-105"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <!-- Subtle bottom gradient vignette -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent pointer-events-none rounded-2xl md:rounded-3xl"></div>
    </div>
  </div>
</section>
