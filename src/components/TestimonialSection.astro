---
import SectionLabel from "./SectionLabel.astro";
import { testimonialsData } from "../data/siteData";
---

<section id="testimonials" class="py-16 md:py-28 relative">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <!-- Header -->
    <div class="mb-12 md:mb-16">
      <div class="mb-3">
        <SectionLabel text="TESTIMONIAL" />
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#030303]">
        What Our Clients Say
      </h2>
    </div>

    <!-- Testimonial Interactive Showcase (Matching Recording 00:46-00:52) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <!-- Left Column: Rating, Quotes, Client Name, and Navigation -->
      <div class="lg:col-span-7 flex flex-col justify-between min-h-[380px]">
        <div>
          <!-- 5 Gold Stars Rating -->
          <div class="flex items-center gap-1 text-[#D4AF37] mb-6" aria-label="5 out of 5 stars">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <!-- Stylized Quotation Mark -->
          <span class="text-5xl font-serif text-[#C5A880] block mb-2 leading-none" aria-hidden="true">
            “
          </span>

          <!-- Animated Quote Text Containers -->
          <div class="relative min-h-[140px] mb-8">
            {testimonialsData.map((t, idx) => (
              <blockquote
                class={`testimonial-quote absolute inset-0 text-lg sm:text-xl md:text-2xl font-normal text-[#030303] leading-relaxed transition-all duration-500 ${idx === 0 ? 'opacity-100 translate-y-0 pointer-events-auto' : 'opacity-0 translate-y-4 pointer-events-none'}`}
                data-index={idx}
              >
                "{t.quote}"
              </blockquote>
            ))}
          </div>

          <!-- Client Author Information -->
          <div class="relative min-h-[60px]">
            {testimonialsData.map((t, idx) => (
              <div
                class={`testimonial-author absolute inset-0 transition-all duration-500 ${idx === 0 ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-2 pointer-events-none'}`}
                data-index={idx}
              >
                <h3 class="text-xl font-bold text-[#030303]">{t.author}</h3>
                <p class="text-sm text-[#737373]">{t.role} at {t.company}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Controls & Slide Counter (Matching Recording 00:48) -->
        <div class="flex items-center gap-6 pt-8 border-t border-black/10">
          <!-- Slide Counter -->
          <span id="testimonial-counter" class="text-sm font-mono tracking-widest text-[#737373]">
            01 / 03
          </span>

          <!-- Navigation Buttons -->
          <div class="flex items-center gap-3">
            <button
              id="testimonial-prev"
              type="button"
              class="w-11 h-11 rounded-full border border-black/15 bg-white text-black flex items-center justify-center hover:bg-black hover:text-white transition-all cursor-pointer shadow-xs active:scale-95"
              aria-label="Previous testimonial"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
            </button>
            <button
              id="testimonial-next"
              type="button"
              class="w-11 h-11 rounded-full border border-black/15 bg-white text-black flex items-center justify-center hover:bg-[#C5A880] hover:border-[#C5A880] hover:text-white transition-all cursor-pointer shadow-xs active:scale-95"
              aria-label="Next testimonial"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Right Column: Client Portrait Photo with Smooth Crossfade -->
      <div class="lg:col-span-5">
        <div class="relative overflow-hidden rounded-2xl md:rounded-3xl shadow-xl border border-black/5 aspect-[4/5] bg-neutral-100">
          {testimonialsData.map((t, idx) => (
            <img
              src={t.avatar}
              alt={`Portrait of ${t.author}`}
              class={`testimonial-avatar absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ease-in-out ${idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
              data-index={idx}
              loading="lazy"
            />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  let currentIndex = 0;
  const quotes = document.querySelectorAll<HTMLElement>('.testimonial-quote');
  const authors = document.querySelectorAll<HTMLElement>('.testimonial-author');
  const avatars = document.querySelectorAll<HTMLElement>('.testimonial-avatar');
  const counter = document.getElementById('testimonial-counter');
  const prevBtn = document.getElementById('testimonial-prev');
  const nextBtn = document.getElementById('testimonial-next');
  const total = quotes.length;

  function setTestimonial(index: number) {
    if (index < 0) index = total - 1;
    if (index >= total) index = 0;
    currentIndex = index;

    // Update Counter
    if (counter) {
      counter.textContent = `0${currentIndex + 1} / 0${total}`;
    }

    // Update Quotes
    quotes.forEach((q, idx) => {
      if (idx === currentIndex) {
        q.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
        q.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
      } else {
        q.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
        q.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
      }
    });

    // Update Authors
    authors.forEach((a, idx) => {
      if (idx === currentIndex) {
        a.classList.remove('opacity-0', 'translate-y-2', 'pointer-events-none');
        a.classList.add('opacity-100', 'translate-y-0');
      } else {
        a.classList.remove('opacity-100', 'translate-y-0');
        a.classList.add('opacity-0', 'translate-y-2', 'pointer-events-none');
      }
    });

    // Update Avatars
    avatars.forEach((av, idx) => {
      if (idx === currentIndex) {
        av.classList.remove('opacity-0', 'z-0');
        av.classList.add('opacity-100', 'z-10');
      } else {
        av.classList.remove('opacity-100', 'z-10');
        av.classList.add('opacity-0', 'z-0');
      }
    });
  }

  prevBtn?.addEventListener('click', () => setTestimonial(currentIndex - 1));
  nextBtn?.addEventListener('click', () => setTestimonial(currentIndex + 1));
</script>
